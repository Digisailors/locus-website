            .tsingoal-group {
                display: inline-block;
                width: 32px;
                height: 32px;
                cursor: pointer;
                margin-top: 24px;
                margin-left: 23px;
                position: relative;
            }
            .tsingoal-group img {
                width: 100%;
                height: 100%;
            }
            .tsingoal-group img.normal {
                display: block;
            }
            .tsingoal-group img.hover {
                display: none;
            }
            .tsingoal-group:hover img.normal {
                display: none;
            }
            .tsingoal-group:hover img.hover {
                display: block;
