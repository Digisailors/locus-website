<script>
  function open53() {
    var _53api = $53.createApi();    //$53这个对象是从53挂码获取的	
    _53api.push('cmd', 'kfclient');
    _53api.push('type', 'popup');    //popup是弹窗，new是新窗口。浮动窗口就是页面右下角弹出的小窗口，新窗口是一个相对大的浮层窗口，可以自己测试看下
    _53api.query();
  }
  const topBtn = document.querySelector('.pop-up');
  topBtn.onclick = () => window.scrollTo({ top: 0, behavior: "smooth" });
</script>
<script>
    function isFromSearchEngine(referrer) {
  if (!referrer) return false;

  try {
    const host = new URL(referrer).hostname;
    const searchEngines = [
      'google.',
      'bing.com',
      'yahoo.',
      'duckduckgo.com',
      'baidu.com',
      'yandex.',
      'naver.com',
      'seznam.cz',
      'ecosia.org',
      'sogou.com',
      'startpage.com',
      'qwant.com'
    ];

    return searchEngines.some(domain => host.includes(domain));
  } catch (e) {
    return false;
  }
}


(function trackFirstReferrer() {
  const ref = document.referrer;
  if (!sessionStorage.getItem('referrer') && isFromSearchEngine(ref)) {
    sessionStorage.setItem('referrer', ref);
  }
})();
</script>
</body>

</html><?