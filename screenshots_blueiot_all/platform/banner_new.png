                display: inline-block;
            }
            .bpp-login-boxs i {
                width: 1px;
                height: 12px;
                background-color: #BDBDBD;
                margin: -4px 7px 0;
                display: inline-block;
            }
            .bpp-login-boxs img {
                margin-top: -2px;
            }
            .bpp-login-boxs img.hover {
                display: none;
            }
            .bpp-login-boxs:hover img.normal {
                display: none;
            }
            .bpp-login-boxs:hover img.hover {
                display: inline-block;
            }
            .bpp-login-boxs span {
                line-height: 40px;
                display: inline-block;
